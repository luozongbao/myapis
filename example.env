# =============================================================
# MyAPIs - Environment Configuration Example
# -------------------------------------------------------------
# Copy this file to `.env` and adjust the values as needed.
# The docker-compose stack reads variables from `.env` only.
# =============================================================

# -----------------------------------------------------------
# General Project
# -----------------------------------------------------------
# Friendly project name used as a Docker network / volume prefix
PROJECT_NAME=myapis

# Timezone used by PHP and the container (e.g. Asia/Bangkok)
TZ=Asia/Bangkok

# -----------------------------------------------------------
# Web Server (Nginx) - Public Port
# -----------------------------------------------------------
# Host port mapped to Nginx container port 80
# Change this if 8080 is already in use on your host
WEB_PORT=8080

# -----------------------------------------------------------
# PHP-FPM
# -----------------------------------------------------------
# Host port for PHP-FPM (optional, mostly used for debugging)
PHP_FPM_PORT=9000

# -----------------------------------------------------------
# PHP Configuration
# -----------------------------------------------------------
# Memory limit for PHP scripts
PHP_MEMORY_LIMIT=256M

# Max upload size (must match Nginx client_max_body_size)
PHP_UPLOAD_MAX_FILESIZE=10M
PHP_POST_MAX_SIZE=10M

# Default timezone for PHP date functions
PHP_DATE_TIMEZONE=Asia/Bangkok

# -----------------------------------------------------------
# Nginx Limits
# -----------------------------------------------------------
# Maximum allowed size of the client request body
NGINX_CLIENT_MAX_BODY_SIZE=10M

# Per-source-IP request rate limit (requests / minute).
# Consumed by docker/nginx/00-envsubst.sh and inserted into
# the `limit_req_zone` directive. burst=20 is hard-coded in
# the template (absorbs small spikes with nodelay).
#   ISSUE-001: lower this for tighter quotas; 100 is a sane
#   default for a public API.
RATE_LIMIT_PER_MINUTE=100

# -----------------------------------------------------------
# Development / Production
# -----------------------------------------------------------
# Set to "production" to disable PHP error display
APP_ENV=development

# -----------------------------------------------------------
# Umami Analytics (self-hosted, no cookies, works in China)
# -----------------------------------------------------------
# Host port mapped to the Umami web container (port 3000)
# Change this if 3000 is already in use on your host
UMAMI_PORT=3000

# PostgreSQL database used by Umami
UMAMI_DB_NAME=umami
UMAMI_DB_USER=umami
UMAMI_DB_PASSWORD=umami

# Long random string used by Umami to sign sessions
# Generate one with: openssl rand -hex 32
UMAMI_APP_SECRET=change-me-with-openssl-rand-hex-32

# Shared secret between the PHP tracker and Umami.
# Must match `UMAMI_API_TOKEN` on the Umami dashboard.
# The PHP side reads this and forwards it as a Bearer token.
UMAMI_API_TOKEN=

# -----------------------------------------------------------
# Analytics provider (consumed by docker/php/analytics.php)
# -----------------------------------------------------------
# Which tracking snippet to inject into every HTML response.
# Accepted values:
#   none   - disabled (default, nothing is emitted)
#   umami  - inject Umami <script> tag (self-hosted, cookie-less)
#   ga4    - inject Google Analytics 4 gtag.js snippet
#   google - alias of ga4
ANALYTICS_PROVIDER=none

# ---- Umami ----
# Full URL to your Umami tracker script. When you run Umami via
# docker-compose (the optional service in docker-compose.yml),
# leave this as the container-internal URL:
UMAMI_SCRIPT_URL=http://umami:3000/script.js
# Public Umami website UUID shown in the Umami dashboard
UMAMI_WEBSITE_ID=

# ---- Google Analytics 4 ----
# Your GA4 measurement ID, looks like G-XXXXXXXXXX
GA4_MEASUREMENT_ID=
